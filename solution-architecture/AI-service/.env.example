# Database Configuration
DB_SERVER=YOUR_SERVER\YOUR_INSTANCE
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME
DB_PORT=1433

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# AI Model Configuration
AI_MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.3
MAX_RESULTS=5

# Cache Configuration
CACHE_TTL_SECONDS=600
ERRORS_CACHE_TTL_SECONDS=3600

# CORS
CORS_ORIGINS=["http://localhost:4200","http://localhost:5000"]
