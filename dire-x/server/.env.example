# ============================================
# DIRE-X Server — Environment Variables
# Copy to .env and fill in values
# ============================================

# Server
PORT=4000
NODE_ENV=development

# Supabase (PostgreSQL)
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter (Free AI models)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin API Key (v2.0) — set this to a stable value so it survives restarts
# If not set, a random key is generated on each startup (printed to console)
ADMIN_API_KEY=your-admin-key-here
