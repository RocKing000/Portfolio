# ============================================
# DIRE-X Client — Environment Variables
# Copy to .env and fill in values
# ============================================

# ── Game / simulation backend (Node.js / Express) ───────────────────────────
# Dev: leave empty — Vite proxy handles /api → localhost:4000
# Prod: set to your game backend URL
VITE_API_URL=

# ── DIRE-X Scoring backend (FastAPI on Render) ───────────────────────────────
# Dev: leave empty — Vite proxy handles /direx → localhost:8000
# Prod: set to your deployed Render URL (no trailing slash)
VITE_DIREX_API_URL=https://dire-x-backend.onrender.com

# Dev-only: FastAPI local server URL (used by Vite proxy, NOT bundled into app)
VITE_DIREX_DEV_URL=http://localhost:8000

# Optional: Analytics / Monitoring
# VITE_SENTRY_DSN=https://...
