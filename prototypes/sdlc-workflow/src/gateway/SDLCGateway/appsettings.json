{
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/sdlc-suite",
    "Audience": "sdlc-gateway"
  },
  "ConnectionStrings": {
    "SqlServer": "Server=sqlserver;Database=SDLCAutomation;User Id=sa;Password=${SQLSERVER_SA_PASSWORD};TrustServerCertificate=True;"
  },
  "Redis": {
    "Url": "redis://:${REDIS_PASSWORD}@redis:6379"
  },
  "RabbitMQ": {
    "Url": "amqp://sdlc_admin:${RABBITMQ_PASSWORD}@rabbitmq:5672/sdlc"
  },
  "Logging": {
    "ElasticsearchUrl": "http://elasticsearch:9200",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "http://localhost:5000"
  ]
}
