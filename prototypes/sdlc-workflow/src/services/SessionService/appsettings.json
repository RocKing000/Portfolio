{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=SDLCSuite;User Id=sa;Password=${SQLSERVER_SA_PASSWORD};TrustServerCertificate=True;"
  },
  "RabbitMQ": {
    "Url": "amqp://sdlc:${service_password}@localhost:5672/sdlc"
  },
  "Redis": {
    "Url": "redis://:${REDIS_PASSWORD}@localhost:6379"
  },
  "Minio": {
    "Endpoint":    "localhost:9000",
    "AccessKey":   "${MINIO_ROOT_USER}",
    "SecretKey":   "${MINIO_ROOT_PASSWORD}",
    "UseSSL":      false,
    "PlansBucket": "sdlc-plans"
  },
  "Grpc": {
    "Component1Url": "http://agent-component1:50051",
    "Component2Url": "http://agent-component2:50051",
    "Component3Url": "http://agent-component3:50051",
    "Component4Url": "http://agent-component4:50051"
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "http://localhost:8080/realms/sdlc-suite",
        "Audience": "sdlc-gateway"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
