# Copy to .env and fill in values before running
COMPOSE_PROJECT_NAME=sdlc_suite

# SQL Server
SQLSERVER_SA_PASSWORD=your_sqlserver_password
SQLSERVER_DB=SDLCAutomation

# RabbitMQ
RABBITMQ_USER=sdlc_admin
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=sdlc

# Redis
REDIS_PASSWORD=your_redis_password

# MinIO
MINIO_ROOT_USER=sdlc_minio
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_BUCKET_PLANS=sdlc-plans
MINIO_BUCKET_DOCUMENTS=sdlc-documents
MINIO_BUCKET_CODE=sdlc-code
MINIO_BUCKET_AUDIT=sdlc-audit

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_password
KEYCLOAK_REALM=sdlc-suite

# ELK Stack
ELASTIC_PASSWORD=your_elastic_password
ELASTIC_VERSION=8.12.0
KIBANA_SYSTEM_PASSWORD=your_kibana_password

# Monitoring
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# LLM Providers (set the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

LLM_DEFAULT_PROVIDER=anthropic
LLM_DEFAULT_MODEL_ECONOMY=claude-haiku-4-5-20251001
LLM_DEFAULT_MODEL_STANDARD=claude-sonnet-4-6
LLM_DEFAULT_MODEL_PREMIUM=claude-opus-4-7

# Service Ports
GATEWAY_PORT=5000
SESSION_SERVICE_PORT=5001
AUDIT_SERVICE_PORT=5002
DOCUMENT_SERVICE_PORT=5003
ANONYMIZATION_SERVICE_PORT=5004

# Agent gRPC Ports
AGENT_COMPONENT1_GRPC_PORT=50051
AGENT_COMPONENT2_GRPC_PORT=50052
AGENT_COMPONENT3_GRPC_PORT=50053
AGENT_COMPONENT4_GRPC_PORT=50054
